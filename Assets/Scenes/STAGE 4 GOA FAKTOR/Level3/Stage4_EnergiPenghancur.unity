  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Level 1\nFaktor adalah bilangan yang bisa membagi habis bilangan lain
    tanpa sisa.\nContoh: faktor dari 32 adalah bilangan yang kalau dikalikan bisa
    menghasilkan 32, seperti 2 \xD7 16 = 32.\nJadi 2 dan 16 adalah faktor dari 32.\n\nLevel
    2\nKita berlatih mencari bilangan yang merupakan faktor dari suatu angka.\nContoh:
    dari angka 3, 6, 9, dan 8, manakah yang bisa membagi habis 32?\nJawabannya 8,
    karena 32 \xF7 8 = 4 (habis, tidak ada sisa).\n\nLevel 3\nDi level ini, kita
    harus menuliskan semua faktor dari suatu bilangan.\nContoh faktor dari 32 adalah:
    1, 2, 4, 8, 16, dan 32.\nSemua bilangan itu bisa membagi 32 tanpa sisa."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
