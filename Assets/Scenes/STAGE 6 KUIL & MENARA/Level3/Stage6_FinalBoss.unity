  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Level 1\nKPK artinya Kelipatan Persekutuan Terkecil. Cara mencarinya:\n1.
    Buat daftar kelipatan bilangan pertama (misalnya kelipatan 3: 3, 6, 9, 12, 15,
    \u2026).\n2. Buat daftar kelipatan bilangan kedua (misalnya kelipatan 4: 4, 8,
    12, 16, \u2026).\n3. Cari angka yang sama di kedua daftar.\n4. Pilih yang paling
    kecil.\nItulah KPK-nya.\n\nLevel 2\nKita berlatih menentukan KPK dari dua bilangan.\nContoh:
    KPK dari 4 dan 6 adalah 12.\nKarena 12 adalah kelipatan terkecil yang sama-sama
    dimiliki oleh 4 dan 6.\n\nLevel 3\nDi level terakhir, kita harus menghitung sendiri
    KPK-nya dan menuliskan jawabannya.\nContoh: KPK dari 6 dan 8 adalah 24.\nInilah
    kunci untuk mengalahkan musuh terakhir."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 79459efec17a4d00a321bdcc27bbc385, type: 2}
